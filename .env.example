# Browser-visible variables only. Vite embeds every VITE_* value in the client bundle.
# Use the Supabase project URL and publishable/anon key; these are designed to be public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Do not add service-role, AI, email, database, scanner, or cron secrets here.
# Set those with `supabase secrets set` for Edge Functions or in your server host.
